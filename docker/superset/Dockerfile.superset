FROM apache/superset:5.0.0

USER root

# Drivers for the twin database (PostgreSQL / TimescaleDB) plus xlsx export.
# No headless browser: Alerts & Reports run in TEXT mode (see superset_config.py).
RUN . /app/.venv/bin/activate && \
    uv pip install \
      psycopg2-binary \
      openpyxl \
      "gevent>=1.4.0"

COPY scripts/superset-init.sh /app/superset-init.sh
RUN sed -i 's/\r$//' /app/superset-init.sh && chmod +x /app/superset-init.sh

USER superset

CMD ["/app/superset-init.sh"]
