# TwinLab Development Environment Configuration

# Superset Configuration
SUPERSET_SECRET_KEY=your-secret-key-change-this-in-production-this-is-32-chars-minimum
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-this-is-32-chars-minimum
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@twinlab.local
SUPERSET_ADMIN_PASSWORD=admin123
