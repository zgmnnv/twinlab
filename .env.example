# TwinLab lean stack — copy to .env and adjust.
# Generate secrets with:  openssl rand -hex 32

# --- ports ---
TWINLAB_PORT=8080          # nginx gateway: webapp + flow view + twin-service API
SUPERSET_PORT=8088         # Apache Superset (served directly, not via the gateway)

# --- database (shared by twin-service and Superset) ---
POSTGRES_USER=twin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twin

# --- twin-service ---
TWIN_SEED_DEMO=true          # load the tincture demo twin on first start
TWIN_CORS_ORIGINS=*

# --- Superset ---
SUPERSET_SECRET_KEY=change-me-generate-a-32-char-minimum-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_PUBLIC_URL=http://localhost:8088/

# --- Superset Alerts & Reports (only with --profile reports) ---
# REDIS_URL is set automatically by the compose profile.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_MAIL_FROM=twinlab@localhost
