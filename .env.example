# TwinLab Development Environment Configuration

# Superset Configuration
SUPERSET_SECRET_KEY=your-secret-key-change-this-in-production-this-is-32-chars-minimum
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-this-is-32-chars-minimum
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@twinlab.local
SUPERSET_ADMIN_PASSWORD=admin123
PREFERRED_URL_SCHEME=http
FORWARDED_ALLOW_IPS=*

# Database Configuration (for Superset metadata)
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Celery Configuration (Redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# SMTP Configuration (for Alerts & Reports)
# For testing with MailHog (default)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=noreply@superset.com

# For production SMTP (uncomment and configure)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_MAIL_FROM=your_email@gmail.com

# WebDriver Configuration (for PDF/Screenshot generation)
WEBDRIVER_BASEURL=http://superset:8088
WEBDRIVER_BASEURL_USER_FRIENDLY=http://localhost:8088
WEBDRIVER_TYPE=chrome

# Jupyter Configuration
JUPYTER_ENABLE_LAB=yes
JUPYTER_TOKEN=
NB_UID=1000
NB_GID=1000

# Development Settings
ENVIRONMENT=development
DEBUG=true
